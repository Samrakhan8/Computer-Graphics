#include <GL/glut.h>
#include <cmath>
#include <iostream>

void draw_pixel(int x, int y) {
    glPointSize(3.0f);
    glBegin(GL_POINTS);
        glVertex2i(x, y);
    glEnd();
}

void ddaLine(int x0, int y0, int x1, int y1) {
    int dx = x1 - x0;
    int dy = y1 - y0;

    int steps = std::max(std::abs(dx), std::abs(dy));

    float x_inc = (float)dx / (float)steps;
    float y_inc = (float)dy / (float)steps;

    float x = x0;
    float y = y0;

    for (int i = 0; i <= steps; i++) {
        draw_pixel((int)std::round(x), (int)std::round(y));
        x += x_inc;
        y += y_inc;
    }
}

void display() {
    glClear(GL_COLOR_BUFFER_BIT);

    // Line 1: Positive slope (Green)
    glColor3f(0.0f, 1.0f, 0.53f);
    ddaLine(30, 40, 170, 110);

    // Line 2: Negative slope (Orange)
    glColor3f(1.0f, 0.6f, 0.0f);
    ddaLine(30, 140, 170, 40);

    glFlush();
}

int main(int argc, char** argv) {
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(600, 600);
    glutCreateWindow("Lab 4: DDA Line Drawing Algorithm");
    glClearColor(0, 0, 0, 1);
    gluOrtho2D(0, 200, 0, 180);
    glutDisplayFunc(display);
    glutMainLoop();
    return 0;
}
